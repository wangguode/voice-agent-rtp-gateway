# ============================================================================
# wg-voice-gateway 配置文件 (.env)
# 默认 RUN_MODE=mock 无需任何 API Key 即可开箱运行并验证完整打断闭环！
# 生产环境切换为 RUN_MODE=cloud 并填入对应厂商密钥。
# ============================================================================

RUN_MODE=mock                     # mock (零配置离线演示) | cloud (真实云端大模型与语音)

# --- LLM 大模型配置 (支持 DeepSeek / 通义千问 Qwen / OpenAI 兼容接口) ---
LLM_PROVIDER=deepseek             # deepseek | qwen | openai
DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-qwen-dashscope-key
OPENAI_API_KEY=sk-your-openai-key

# --- STT 语音识别配置 (支持本地 FunASR SenseVoice / Deepgram / OpenAI) ---
STT_PROVIDER=funasr               # funasr (本地中文高准度) | deepgram | openai
DEEPGRAM_API_KEY=your-deepgram-key

# --- TTS 语音合成配置 (支持 MiniMax 海螺语音 / Kokoro 本地合成 / FishAudio) ---
TTS_PROVIDER=minimax              # minimax | kokoro | cartesia
MINIMAX_API_KEY=your-minimax-key
MINIMAX_GROUP_ID=your-minimax-group-id
MINIMAX_VOICE_ID=Calm_Woman

# --- FreeSWITCH 网关与 RTP 参数 ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765
FREESWITCH_SAMPLE_RATE=8000       # PSTN 电话网标准采样率 8kHz (G.711 / L16)
PIPELINE_SAMPLE_RATE=16000        # AI 语音管道内部采样率 16kHz
VAD_STOP_SECS=0.28                # 静音尾点判停阈值 (秒)
